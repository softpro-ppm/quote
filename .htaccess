# Single Page App: serve index.html for client-side routes (React Router).
# Upload this file to the same folder as index.html (usually public_html).
# If the site lives in a subfolder, set RewriteBase to that path (e.g. RewriteBase /quote/)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
