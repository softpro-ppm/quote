# SPA fallback for this folder. Place this file inside public_html/quote next to index.html.
# Do not use RewriteBase / here — the app is deployed as a subfolder.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /quote/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
