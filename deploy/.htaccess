# SBI Quote — quote.softpromis.com (docroot = public_html/quote/)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Main domain /quote/* ? subdomain (app lives only on quote.softpromis.com)
  RewriteCond %{HTTP_HOST} ^(www\.)?softpromis\.com$ [NC]
  RewriteRule ^(.*)$ https://quote.softpromis.com/$1 [R=301,L]

  # /api/* ? Laravel (symlink quote-backend/ in this folder)
  RewriteRule ^api(?:(/.*)?)$ quote-backend/public/index.php [L,QSA]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
